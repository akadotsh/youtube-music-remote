{
  "name": "youtube-music-remote",
  "private": true,
  "packageManager": "pnpm@10.7.0",
  "scripts": {
    "build": "pnpm -r build",
    "desktop:bundle": "node ./scripts/bundle-desktop.js",
    "desktop:check": "node ./scripts/desktop-check.js",
    "desktop:prepare-adapter": "./scripts/prepare-mediaremote-adapter.sh",
    "desktop:run": "cargo run --bin yt-remote-desktop",
    "desktop:status": "node ./scripts/desktop-status.js",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "@types/node": "^24.9.0",
    "typescript": "^5.9.3"
  }
}
