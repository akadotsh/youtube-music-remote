{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "youtube-music-remote-relay",
  "main": "src/index.ts",
  "compatibility_date": "2025-10-14",
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "RelayRoom" },
      { "name": "PAIRING_LIMITER", "class_name": "PairingLimiter" }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["RelayRoom", "PairingLimiter"]
    }
  ]
}
